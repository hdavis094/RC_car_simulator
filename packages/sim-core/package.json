{
  "name": "@rcsim/sim-core",
  "version": "0.0.0",
  "private": true,
  "description": "Headless simulation: clock, world, physics, actuators, sensors, firmware bridge, scenario runner",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./stubs": "./src/api/stubs/index.ts"
  },
  "bin": {
    "rcsim": "./src/scenario/bin.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "test:scenarios": "node scripts/scenarios-placeholder.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "@rcsim/schema": "workspace:*",
    "@rcsim/sim-protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
