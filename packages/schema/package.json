{
  "name": "@rcsim/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas for part definitions, car.json and worlds; wiring rules; car_config.h generator; default catalog",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog/*": "./catalog/*",
    "./examples/*": "./examples/*",
    "./json-schema/*": "./json-schema/*"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "generate": "node scripts/generate-json-schemas.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
