{
  "name": "rcsim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @rcsim/desktop dev",
    "format": "prettier --write . && pnpm --filter @rcsim/hal format",
    "format:check": "prettier --check . && pnpm --filter @rcsim/hal format:check",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p . && pnpm -r --parallel typecheck",
    "test:unit": "vitest run",
    "test:hal": "pnpm --filter @rcsim/hal test",
    "test:scenarios": "pnpm --filter @rcsim/sim-core test:scenarios",
    "test:e2e": "pnpm --filter @rcsim/desktop build && playwright test",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:hal",
    "verify": "pnpm verify:fast && pnpm test:scenarios && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
